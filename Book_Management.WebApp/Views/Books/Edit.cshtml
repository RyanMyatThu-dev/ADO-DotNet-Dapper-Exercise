@model BookViewModel
@{
    ViewData["Title"] = $"{ViewBag.ProviderLabel} — Edit Book";
}

<div class="page-header">
    <h2>Edit Book</h2>
    <a href="/@ViewBag.Provider/books" class="btn btn-ghost">← Back</a>
</div>

<form asp-action="Edit" method="post" class="form">
    @Html.AntiForgeryToken()

    <input type="hidden" name="Provider" value="@ViewBag.Provider" />
    <input type="hidden" name="Id" value="@Model.Id" />

    <div class="form-group">
        <label for="Title">Title</label>
        <input type="text" id="Title" name="Title" class="form-input" value="@Model.Title" required />
    </div>

    <div class="form-group">
        <label for="Author">Author</label>
        <input type="text" id="Author" name="Author" class="form-input" value="@Model.Author" required />
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="Genre">Genre</label>
            <input type="text" id="Genre" name="Genre" class="form-input" value="@Model.Genre" />
        </div>
        <div class="form-group">
            <label for="PublishedDate">Published Date</label>
            <input type="date" id="PublishedDate" name="PublishedDate" class="form-input"
                   value="@Model.PublishedDate?.ToString("yyyy-MM-dd")" />
        </div>
    </div>

    <div class="form-group">
        <label for="Description">Description</label>
        <textarea id="Description" name="Description" class="form-input form-textarea" rows="4">@Model.Description</textarea>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">Save Changes</button>
        <a href="/@ViewBag.Provider/books" class="btn btn-ghost">Cancel</a>
    </div>
</form>
