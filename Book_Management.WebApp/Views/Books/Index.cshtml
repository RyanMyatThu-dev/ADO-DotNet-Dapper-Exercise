@model IEnumerable<BookViewModel>
@{
    ViewData["Title"] = $"{ViewBag.ProviderLabel} — Books";
}

<div class="page-header">
    <h2>@ViewBag.ProviderLabel — Books</h2>
    <a href="/@ViewBag.Provider/books/create" class="btn btn-primary">+ New Book</a>
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <p>No books found. Create your first book to get started.</p>
    </div>
}
else
{
    <div class="table-container">
        <table class="table">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Author</th>
                    <th>Genre</th>
                    <th>Published</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var book in Model)
                {
                    <tr>
                        <td class="cell-title">@book.Title</td>
                        <td class="cell-author">@book.Author</td>
                        <td class="cell-genre">@(book.Genre ?? "—")</td>
                        <td class="cell-date">@book.PublishedDate?.ToString("yyyy-MM-dd")</td>
                        <td class="cell-actions">
                            <a href="/@ViewBag.Provider/books/edit/@book.Id" class="btn-sm">Edit</a>
                            <form action="/@ViewBag.Provider/books/delete/@book.Id" method="post"
                                  class="inline-form"
                                  onsubmit="return confirm('Delete &ldquo;@book.Title&rdquo;?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn-sm btn-sm-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
